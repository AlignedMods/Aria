module std::core;

import std::core::mem;

struct StringStream {
    mem: *char;
    len: sz;
    capacity: sz;
}

impl StringStream {
    fn append_string(s: String) -> void {
        for (i: sz = 0; i < s.len; i++) {
            append_char(s[i]);
        }
    }

    fn append_char(c: char) -> void {
        if capacity == 0 { increase_capacity(32); }

        if len + 1 >= capacity {
            let newCap = capacity + 1;
            increase_capacity(((newCap + 32 - 1) / 32) * 32); // Align the new capacity to 32 bytes
        }

        mem[len] = c;
        len += 1;
    }

    fn append_bool(b: bool) -> void {
        if b {
            append_string("true");
        } else {
            append_string("false");
        }
    }

    // Integer formatting
    fn append_int(l: long) -> void {
        let u = cast(ulong, l);
    
        if (l < 0) {
            append_char('-');
            append_uint(u);
        } else {
            append_uint(u);
        }
    }

    fn append_uint(u: ulong) -> void {
        let buf: [32]char;
        let i: isz;

        do {
            buf[i++] = '0' + (u % 10u);
            u /= 10u;
        } while u > 0;

        for (j: isz = 1; j < i + 1; j++) {
            append_char(buf[i - j]);
        }
    }

    fn append_any(arg: *any) {
        if arg.type == char {
            append_char(core::any_cast::<char>(arg));
            return;
        }

        if arg.type == ichar {
            append_char(core::any_cast::<ichar>(arg));
            return;
        }

        if arg.type == bool {
            append_bool(core::any_cast::<bool>(arg));
            return;
        }

        if arg.type == short {
            append_int(core::any_cast::<short>(arg));
            return;
        }

        if arg.type == ushort {
            append_uint(core::any_cast::<ushort>(arg));
            return;
        }

        if arg.type == int {
            append_int(core::any_cast::<int>(arg));
            return;
        }

        if arg.type == uint {
            append_uint(core::any_cast::<uint>(arg));
            return;
        }

        if arg.type == long {
            append_int(core::any_cast::<long>(arg));
            return;
        }

        if arg.type == ulong {
            append_uint(core::any_cast::<ulong>(arg));
            return;
        }

        if arg.type == sz {
            append_uint(core::any_cast::<sz>(arg));
            return;
        }

        if arg.type == isz {
            append_int(core::any_cast::<isz>(arg));
            return;
        }

        if arg.type == String {
            append_string(core::any_cast::<String>(arg));
            return;
        }

        if core::any_is_array(arg) {
            return;
        }
    }

    fn appendf(fmt: String, args...) -> void {
        vappendf(fmt, args);
    }

    fn vappendf(fmt: String, args: []any) -> void {
        let var_idx = 0;

        for (i: sz = 0; i < fmt.len; i++) {
            if fmt[i] == '%' {
                i++;
                if fmt[i] == '%' {
                    append_char('%');
                } else if fmt[i] == 's' {
                    if var_idx < args.len {
                        let arg = &args[var_idx++];
                        append_any(arg);
                    }
                }
            } else {
                append_char(fmt[i]);
            }
        }
    }

    fn to_string() -> String { return to_slice(); }

    fn to_slice() -> []char {
        return mem[:len];
    }

    fn to_ptr() -> *char {
        append_char('\0');
        return mem;
    }

    fn free() -> void {
        mem::free(mem);
        len = 0;
        capacity = 0;
    }

    fn increase_capacity(cap: ulong) -> void {
        let newData = mem::new_array::<char>(cap);
        
        if (mem != null) {
            mem::copy(newData, mem, len);
            mem::free(mem);
        }
        
        mem = newData;
        capacity = cap;
    }

}
