module std::core;

struct StringStream {
    mem: *char;
    len: sz;
    capacity: sz;

    ~() {
        free();
    }

    fn append_string(s: string) -> void {
        for (i: sz = 0; i < s.len; i++) {
            append_char(s[i]);
        }
    }

    fn append_char(c: char) -> void {
        if capacity == 0 { increase_capacity(32); }

        if len + 1 >= capacity {
            let newCap = capacity + 1;
            increase_capacity(((newCap + 32 - 1) / 32) * 32); // Align the new capacity to 32 bytes
        }

        mem[len] = c;
        len += 1;
    }

    fn appendf(fmt: string, args...) -> void {
        vappendf(fmt, args);
    }

    fn vappendf(fmt: string, args: []any) -> void {
        let f = Formatter(self, &out_stringstream);
        f.vappendf(fmt, args);
    }

    fn to_string() -> string { return to_slice(); }

    fn to_slice() -> []char {
        return mem[:len];
    }

    fn to_ptr() -> *char {
        append_char('\0');
        return mem;
    }

    fn free() -> void {
        mem::free::<char>(mem);
        len = 0;
        capacity = 0;
    }

    fn increase_capacity(cap: ulong) -> void {
        let newData = mem::new_array::<char>(cap);
        
        if (mem != null) {
            mem::copy(newData, mem, len);
            mem::free::<char>(mem);
        }
        
        mem = newData;
        capacity = cap;
    }
}

fn out_stringstream(data: *void, c: char) {
    let s: *StringStream = data;
    s.append_char(c);
}
