module std::core;

extern fn printf(fmt: *const char, ...) -> int;

typedef FormatOutFn = *fn(buf: *void, c: char);

// Function which does nothing on character append
fn out_null(_buf: *void, _c: char) {}

// Static buffer used for integer formatting
const APPEND_INT_BUF_SIZE = 128;

struct FormatFlags {
    width: ulong;
    pad_char: char;
    uppercase: bool;
}

// NOTE: The formatter doesn't do any heap allocations
// You must provide the buffer which will be used
struct Formatter {
    data: *void;
    out_fn: FormatOutFn;
    flags: FormatFlags;

    fn vappendf(fmt: string, args: []any) -> sz {
        if out_fn == null {
            out_fn = &out_null;
        }

        let total_len: sz;
        let var_idx: sz;

        for (i: sz; i < fmt.len; i++) {
            let c = fmt[i];

            if c != '%' {
                total_len += append_char(c);
                continue;
            }

            i++;
            assert_raw(i < fmt.len, __FILE__, __LINE__, "Invalid format");

            c = fmt[i];
            if c == '%' {
                total_len += append_char(c);
                continue;
            }

            assert_raw(var_idx < args.len, __FILE__, __LINE__, "Missing argument");
            let arg = args[var_idx++];

            flags = FormatFlags();
            let base: uint;

            switch c {
                case 's': {
                    total_len += append_any(arg);
                    continue;
                }

                case 'd': {
                    base = 10;
                }

                case 'X': {
                    flags.uppercase = true;
                    nextcase;
                }
                case 'x': {
                    base = 16;
                }

                case 'p': {
                    base = 16;
                    flags.width = 16;
                    flags.pad_char = '0';
                }
            }

            if arg.type.kind == TypeKind.SIGNED_INT {
                append_int(any_to_int::<long>(&arg), base);
                continue;
            } else if arg.type.kind == TypeKind.UNSIGNED_INT || arg.type.kind == TypeKind.POINTER {
                append_uint(any_to_int::<ulong>(&arg), base);
                continue;
            }
        }

        return total_len;
    }

    fn appendf(fmt: string, args...) -> sz {
        return vappendf(fmt, args);
    }

    fn append_char(c: char) -> sz {
        out_fn(data, c);
        return 1;
    }

    fn append_string(s: string) -> sz {
        let total_len: sz;

        for (i: sz = 0; i < s.len; i++) {
            total_len += append_char(s[i]);
        }

        return total_len;
    }

    fn append_buf_reverse(b: []char) -> sz {
        let len = b.len;
        while len > 0 { append_char(b[--len]); }
        return b.len;
    }

    fn append_bool(b: bool) -> sz {
        if b {
            return append_string("true");
        } else {
            return append_string("false");
        }
    }

    fn append_int(i: long, base: uint) -> sz {
        if (i < 0) {
            append_char('-');
            return append_uint(-i, base);
        } else {
            return append_uint(i, base);
        }
    }

    fn append_uint(u: ulong, base: uint) -> sz {
        let buf: [APPEND_INT_BUF_SIZE]char;
        let i: isz;
        let past_10 = (flags.uppercase ? 'A' : 'a') - 10;

        switch base {
            case 10: {
                do {
                    buf[i++] = '0' + (u % 10u);
                    u /= 10u;
                } while u > 0;
            }

            case 16: {
                do {
                    let digit = char(u & 0xF);

                    if digit < 10 { buf[i++] = '0' + digit; }
                    else { buf[i++] = past_10 + digit; }

                    u >>= 4;
                } while u > 0;
            }
        }

        // Handle zero padding
        while i < flags.width {
            buf[i++] = flags.pad_char;
        }

        switch base {
            case 16: {
                buf[i++] = flags.uppercase ? 'X' : 'x';
                buf[i++] = '0';
            }
        }

        return append_buf_reverse(buf[:i]);
    }

    fn append_any(a: any) -> sz {
        switch a.type.kind {
            case TypeKind.BOOL: {
                return append_bool(any_cast::<bool>(&a));
            }

            case TypeKind.SIGNED_INT: {
                return append_int(any_to_int::<long>(&a), 10);
            }

            case TypeKind.UNSIGNED_INT: {
                return append_uint(any_to_int::<ulong>(&a), 10);
            }

            case TypeKind.STRING: {
                return append_string(any_cast::<string>(&a));   
            }

            case TypeKind.ANY: {
                return append_any(any_cast::<any>(&a));
            }

            case TypeKind.POINTER: {
                let width = flags.width;
                let pad_char = flags.pad_char;
                defer {
                    flags.width = width; 
                    flags.pad_char = pad_char;
                }

                flags.width = 16;
                flags.pad_char = '0';
                return append_uint(any_to_int::<ulong>(&a), 16);
            }

            case TypeKind.ARRAY: {
                append_char('[');
                for (i: sz = 0; i < a.type.len; i++) {
                    if i > 0 { append_string(", "); }
                    let val = any_index(&a, i);
                    append_any(val);
                }
                append_char(']');
            }
        }

        return 0;
    }
}
