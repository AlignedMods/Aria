module std::core;

struct StringStream {
    mem: *char;
    len: sz;
    capacity: sz;

    ~() {
        free();
    }

    fn append_string(s: string) -> void {
        for (i: sz = 0; i < s.len; i++) {
            append_char(s[i]);
        }
    }

    fn append_char(c: char) -> void {
        if capacity == 0 { increase_capacity(32); }

        if len + 1 >= capacity {
            increase_capacity(capacity * 2); 
        }

        mem[len] = c;
        len += 1;
    }

    fn appendf(fmt: string, ...args) -> void {
        vappendf(fmt, args);
    }

    fn vappendf(fmt: string, args: []any) -> void {
        let f = Formatter(self, &out_stringstream);
        f.vappendf(fmt, args);
    }

    fn to_string() -> string { return to_slice(); }

    fn to_slice() -> []char {
        return mem[:len];
    }

    // WARNING: This function doesn't append a null terminator
    fn to_cstr() -> *char {
        return mem;
    }

    fn free() -> void {
        mem::free(mem);
        len = 0;
        capacity = 0;
    }

    fn increase_capacity(cap: ulong) -> void {
        let newData = mem::new_array::<char>(cap);
        
        if (mem != null) {
            mem::copy(newData, mem, len);
            mem::free(mem);
        }
        
        mem = newData;
        capacity = cap;
    }
}

fn out_stringstream(data: *void, c: char) {
    let s: *StringStream = data;
    s.append_char(c);
}

struct WStringStream {
    mem: *WChar;
    len: sz;
    capacity: sz;

    ~() {
        free();
    }

    fn append_string(s: string) -> void {
        for (i: sz = 0; i < s.len; i++) {
            append_char(s[i]);
        }
    }

    fn append_char(c: char) -> void {
        // TODO: This is not correct for numbers larger than 127!!
        append_wchar(WChar(c));
    }

    fn append_wchar(c: WChar) -> void {
        if capacity == 0 { increase_capacity(32); }

        if len + 1 >= capacity {
            increase_capacity(capacity * 2); 
        }

        mem[len] = c;
        len += 1;
    }

    fn to_slice() -> []WChar {
        return mem[:len];
    }

    // WARNING: This function doesn't append a null terminator
    fn to_cstr() -> WString {
        return mem;
    }

    // WARNING: This function doesn't append a null terminator
    // NOTE: You must manually free the result of this function using mem::free
    fn to_cstr_copy() -> WString {
        let new_mem = mem::alloc_array::<WChar>(len);
        mem::copy(new_mem, mem, len * @sizeof(WChar));
        return new_mem;
    }

    fn free() -> void {
        mem::free(mem);
        len = 0;
        capacity = 0;
    }

    fn increase_capacity(cap: ulong) -> void {
        let new_data = mem::new_array::<ushort>(cap);
        
        if (mem != null) {
            mem::copy(new_data, mem, len * @sizeof(WChar));
            mem::free(mem);
        }
        
        mem = new_data;
        capacity = cap;
    }
}
