module std::core;

fn assert_raw(cond: bool, file: string, line: ulong, fmt: string, args...) {
    if !cond { vpanicf(file, line, fmt, args); }
}

fn panicf(file: string, line: ulong, fmt: string, args...) -> ! @builtin("panic") {
    vpanicf(file, line, fmt, args);
}

fn vpanicf(file: string, line: ulong, fmt: string, args: []any) -> ! {
    io::eprintf("%s:%s: PANIC: ", file, line);
    io::veprintfn(fmt, args);
    process::abort();
}
