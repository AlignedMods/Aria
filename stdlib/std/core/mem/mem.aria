module std::core::mem;

import libc;

fn copy(_dst: *void, _src: *void, _len: sz) @builtin("memcpy") { /* compiler builtin */ }
fn set(_ptr: *void, _val: char, _len: sz) @builtin("memset") { /* compiler builtin */ }

fn<T> alloc() -> *T {
    return libc::calloc(1, @sizeof(T));
}

fn<T> new(init: T) -> *T {
    let ptr = libc::malloc(@sizeof(T));
    *(*T)(ptr) = init;
    return ptr;
}

// Allocates a new array on the heap of size 'len' and does NOT zero initialize it
fn<T> alloc_array(len: sz) -> []T {
    return (*T)(libc::malloc(len * @sizeof(T)))[:len];
}

// Allocates a new array on the heap of size 'len' and zero initializes it
fn<T> new_array(len: sz) -> []T {
    return (*T)(libc::calloc(len, @sizeof(T)))[:len];
}

fn<T> call_dtor(ptr: *T) {
    $if @defined(ptr.~) {
        ptr.~();
    }
}

fn<T> free(ptr: *T) {
    call_dtor(ptr);
    libc::free(ptr);
}

fn<T> free_array(arr: []T) {
    for (i: sz; i < arr.len; i++) {
        call_dtor(&arr[i]);
    }

    libc::free(arr.mem);
}
