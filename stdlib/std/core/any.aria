module std::core;

import libc;

fn<T> any_to_int(a: any) -> T {
    switch a.type.kind {
        case TypeKind.SIGNED_INT: {
            switch a.type {
                case ichar: return ichar(a);
                case short: return short(a);
                case int: return int(a);
                case long: return long(a);
                case isz: return isz(a);
            }
        }

        case TypeKind.UNSIGNED_INT: {
            switch a.type {
                case char: return char(a);
                case ushort: return ushort(a);
                case uint: return uint(a);
                case ulong: return ulong(a);
                case sz: return sz(a);
            }
        }

        case TypeKind.POINTER: {
            return sz(a);
        }
    }

    return 0;
}

fn any_is_int(a: any) -> bool {
    switch a.type.kind {
        case TypeKind.SIGNED_INT: nextcase;
        case TypeKind.UNSIGNED_INT: nextcase;
        case TypeKind.POINTER: return true;
    }

    return false;
}

// Treats 'a' like an array and indexes into it
fn any_index(a: any, idx: sz) -> any {
    let ptr = a.value + (idx * a.type.inner.size);
    return any(a.type.inner, ptr);
}
