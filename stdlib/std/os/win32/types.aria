module std::os::win32 @if(env::WIN32);

typedef BOOL = int;
typedef BOOLEAN = BYTE;
typedef BYTE = char;
typedef WORD = ushort;
typedef DWORD = uint;
typedef DWORDLONG = ulong;
typedef HANDLE = PVOID;
typedef PVOID = *void;
typedef LPVOID = *void;
typedef LPBYTE = *BYTE;
typedef LPDWORD = *DWORD;
typedef WCHAR = ushort;
typedef LPWSTR = *WCHAR;
typedef LPCWSTR = *const WCHAR;

struct SECURITY_ATTRIBUTES {
    nLength: DWORD;
    lpSecurityDescriptor: LPVOID;
    bInheritHandle: BOOL;
}

typedef LPSECURITY_ATTRIBUTES = *SECURITY_ATTRIBUTES;

struct PROCESS_INFORMATION {
    hProcess: HANDLE;
    hThread: HANDLE;
    dwProcessId: DWORD;
    dwThreadId: DWORD;
}

typedef LPPROCESS_INFORMATION = *PROCESS_INFORMATION;

struct STARTUPINFOW
{
	cb: DWORD;
	lpReserved: LPWSTR;
	lpDesktop: LPWSTR;
	lpTitle: LPWSTR;
	dwX: DWORD;
	dwY: DWORD;
	dwXSize: DWORD;
	dwYSize: DWORD;
	dwXCountChars: DWORD;
	dwYCountChars: DWORD;
	dwFillAttribute: DWORD;
	dwFlags: DWORD;
	wShowWindow: WORD;
	cbReserved2: WORD;
	lpReserved2: LPBYTE;
	hStdInput: HANDLE;
	hStdOutput: HANDLE;
	hStdError: HANDLE;
}

typedef LPSTARTUPINFOW = *STARTUPINFOW;

