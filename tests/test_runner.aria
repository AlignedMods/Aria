module test_runner;

import std;

fn usage() -> ! {
    io::eprintln("test_runner: usage:");
    io::eprintln("  test_runner <compiler_path>");
    process::exit(0);
}

// TODO: Use some kind of directory iterator for this in the future
const TESTS = [ "main_function/main_args_void_ret",
                "main_function/main_args_int_ret",
                "main_function/main_no_args_void_ret",
                "main_function/main_no_args_int_ret"
];

const TEST_SUITE_PATH = "./tests/test_suite/";

fn main(args: []string) {
    if args.len < 2 {
        usage();
    }

    let compiler_path = args[1];
    for (i: sz; i < TESTS.len; i++) {
        let test = TESTS[i];

        let sb: core::StringStream;
        sb.append_string(TEST_SUITE_PATH);
        sb.append_string(test);
        sb.append_string(".aria");

        let ec = process::run_process([
            compiler_path,
            sb.to_string(),
            "--silent",
            "--no-debug",
            "--emit-llvm",
            "-o", ".build\\test"][..]);

        if ec != 0 { io::printfn("Compiler failed to run %s (%x)", ec, uint(ec)); }
    }
}
